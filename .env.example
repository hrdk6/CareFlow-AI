# CareFlow AI configuration. Copy to .env (Docker) or backend/.env (local dev) and fill in the secrets.
# Every backend variable is prefixed CAREFLOW_ and read by backend/app/core/config.py.

# ---- secrets (required) ----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CAREFLOW_JWT_SECRET=
# Docker only: password for the bundled PostgreSQL container
POSTGRES_PASSWORD=
# Password given to the five synthetic demo accounts when the database is seeded
CAREFLOW_DEMO_PASSWORD=CareFlow-Demo-2026

# ---- database (local dev; docker-compose sets its own) ----------------------------------
CAREFLOW_DATABASE_URL=postgresql+psycopg://careflow:careflow@127.0.0.1:5433/careflow

# ---- LLM provider -------------------------------------------------------------------------
# extractive         : no LLM; grounded answers assembled from evidence (default, always works)
# openai_compatible  : Ollama / vLLM / LM Studio / OpenAI-compatible servers (supports tool calling)
# anthropic          : Claude via the official SDK (set ANTHROPIC_API_KEY or CAREFLOW_ANTHROPIC_API_KEY)
CAREFLOW_LLM_PROVIDER=extractive
CAREFLOW_LLM_MODEL=
CAREFLOW_LLM_BASE_URL=http://localhost:11434/v1
CAREFLOW_LLM_API_KEY=
CAREFLOW_ANTHROPIC_API_KEY=
# Optional: reasoning effort for OpenAI-compatible thinking models (e.g. "low" or "none" for Ollama)
CAREFLOW_LLM_REASONING_EFFORT=
CAREFLOW_LLM_TIMEOUT_SECONDS=120

# ---- retrieval --------------------------------------------------------------------------------
CAREFLOW_EMBEDDING_PROVIDER=fastembed
CAREFLOW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CAREFLOW_RERANKER_PROVIDER=cross_encoder
CAREFLOW_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
CAREFLOW_RETRIEVAL_CANDIDATES=30
CAREFLOW_CONTEXT_CHUNKS=6
CAREFLOW_CHUNK_STRATEGY=structure
# quarantine (withhold flagged passages from the LLM) | annotate
CAREFLOW_INJECTION_POLICY=quarantine

# ---- web ----------------------------------------------------------------------------------------
CAREFLOW_CORS_ORIGINS=http://localhost:3000
# Set true behind HTTPS so the session cookie is marked Secure
CAREFLOW_COOKIE_SECURE=false
CAREFLOW_ACCESS_TOKEN_MINUTES=60
