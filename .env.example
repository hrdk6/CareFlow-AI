# CareFlow AI configuration. Copy to .env (Docker) or backend/.env (local dev) and fill in the secrets.
# Every backend variable is prefixed CAREFLOW_ and read by backend/app/core/config.py.

# ---- secrets (required) ----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CAREFLOW_JWT_SECRET=
# Docker only: password for the bundled PostgreSQL container
POSTGRES_PASSWORD=
# Password given to the five synthetic demo accounts when the database is seeded
CAREFLOW_DEMO_PASSWORD=CareFlow-Demo-2026

# ---- database (local dev; docker-compose sets its own) ----------------------------------
CAREFLOW_DATABASE_URL=postgresql+psycopg://careflow:careflow@127.0.0.1:5433/careflow

# ---- LLM provider -------------------------------------------------------------------------
# groq               : Groq cloud, free tier (recommended for hosting; set GROQ_API_KEY)
# gemini             : Google Gemini free-tier model (set GEMINI_API_KEY)
# openai_compatible  : Ollama / vLLM / LM Studio / OpenAI-compatible servers (supports tool calling)
# anthropic          : Claude via the official SDK (set ANTHROPIC_API_KEY or CAREFLOW_ANTHROPIC_API_KEY)
# extractive         : no LLM; grounded answers assembled from evidence (always works)
# Keys belong in backend/.env locally or in the BACKEND host's environment variables - never in the
# frontend/Vercel and never committed.
CAREFLOW_LLM_PROVIDER=extractive
# Backup used automatically if the primary fails (rate limit, outage, bad key, timeout): none | gemini | groq | ...
CAREFLOW_LLM_FALLBACK_PROVIDER=none

# Groq (https://console.groq.com/keys). gpt-oss-120b: strong reasoning + tool calling, 131k context.
GROQ_API_KEY=
CAREFLOW_GROQ_MODEL=openai/gpt-oss-120b
# Tried next, in order, before Gemini. Each Groq model has its own free-tier tokens-per-minute allowance
# (8K/min each on the free tier), so chaining them multiplies capacity. Empty = no extra Groq models.
CAREFLOW_GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
CAREFLOW_GROQ_REASONING_EFFORT=low
# Abandon a stalled Groq request after this many seconds so the backup answers
CAREFLOW_GROQ_TIMEOUT_SECONDS=20

# Google Gemini (https://aistudio.google.com/apikey). gemini-2.5-flash is on the free tier.
GEMINI_API_KEY=
CAREFLOW_GEMINI_MODEL=gemini-2.5-flash
CAREFLOW_GEMINI_REASONING_EFFORT=none

# Settings for openai_compatible (Ollama etc.) and anthropic
CAREFLOW_LLM_MODEL=
CAREFLOW_LLM_BASE_URL=http://localhost:11434/v1
CAREFLOW_LLM_API_KEY=
CAREFLOW_ANTHROPIC_API_KEY=
# Optional: reasoning effort for OpenAI-compatible thinking models (e.g. "low" or "none" for Ollama)
CAREFLOW_LLM_REASONING_EFFORT=
CAREFLOW_LLM_TIMEOUT_SECONDS=120
# auto: the LLM picks tools for unrecognised questions (fast providers such as Claude)
# off : always one synthesis call over the router's plan (recommended for local CPU models)
CAREFLOW_LLM_TOOL_CALLING=auto

# ---- retrieval --------------------------------------------------------------------------------
CAREFLOW_EMBEDDING_PROVIDER=fastembed
CAREFLOW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CAREFLOW_RERANKER_PROVIDER=cross_encoder
CAREFLOW_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
CAREFLOW_RETRIEVAL_CANDIDATES=30
CAREFLOW_CONTEXT_CHUNKS=6
CAREFLOW_CHUNK_STRATEGY=structure
# quarantine (withhold flagged passages from the LLM) | annotate
CAREFLOW_INJECTION_POLICY=quarantine
# Readmission explanations: shap (exact) | tree_path (approximation that saves ~90 MB on 512 MB hosts)
CAREFLOW_ML_EXPLAINER=shap
# CPU threads for the embedding/reranker models; empty = all cores (1 suits small shared-CPU instances)
CAREFLOW_MODEL_THREADS=

# ---- web ----------------------------------------------------------------------------------------
# development | production. Production turns on the public-demo protections below.
CAREFLOW_ENVIRONMENT=development
CAREFLOW_CORS_ORIGINS=http://localhost:3000
# Set true behind HTTPS so the session cookie is marked Secure
CAREFLOW_COOKIE_SECURE=false
CAREFLOW_ACCESS_TOKEN_MINUTES=60

# ---- public demo ----------------------------------------------------------------------------------
# Protect the shared demo accounts (password, role and activation cannot be changed), limit AI questions per
# user, and restrict /metrics to administrators. Empty = on when CAREFLOW_ENVIRONMENT=production.
CAREFLOW_DEMO_PROTECTION=
CAREFLOW_AI_QUERIES_PER_WINDOW=30
CAREFLOW_AI_QUERY_WINDOW_SECONDS=600
